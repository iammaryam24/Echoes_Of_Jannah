{
  "version": 2,
  "builds": [
    {
      "src": "api/auth/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/reflections/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth/$1.js"
    },
    {
      "src": "/api/reflections",
      "dest": "/api/reflections/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}